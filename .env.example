# ─────────────────────────────────────────────────────────────
# Mawa AI config. Copy to .env.local and fill in. NEVER commit .env.local.
# All keys are read on the server only; none use NEXT_PUBLIC_.
# Real process env vars win over this file.
# ─────────────────────────────────────────────────────────────

# --- Auth (Auth.js v5) ---
# Random 32+ byte secret: `openssl rand -base64 33`
AUTH_SECRET=replace-with-random-secret
# Public HTTPS URL of the app (needed for Google OAuth behind a tunnel).
# Example: https://your-assigned-name.ngrok-free.app
# AUTH_URL=
# Trust X-Forwarded-Host / X-Forwarded-Proto from the tunnel (default: true).
# AUTH_TRUST_HOST=true
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID > Web app). Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in (required once Google OAuth is set)
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# Local dev login without Google. Ignored when NODE_ENV=production.
DEV_LOGIN=true

# --- Router ---
# Use a tiny model to classify ambiguous messages (rules handle most).
ROUTER_LLM_CLASSIFIER=false
# SQLite file (M1). Supabase/pgvector replaces this later.
DATABASE_PATH=data/mawa.db

# --- Chat providers (all free tiers; one account per provider) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini + Gemma): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (:free models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI: token with "Workers AI" permission at
# https://dash.cloudflare.com/profile/api-tokens ; account id from the dashboard URL
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# SambaNova Cloud: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# Cohere (trial key, personal last resort): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Z.AI GLM: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# --- Tools (M2) ---
# Pollinations (image gen, server key): https://auth.pollinations.ai
POLLINATIONS_API_KEY=
# Tavily web search (1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=
# --- Planned (not used yet) ---
# Brave Search API ($5 free credit/month): https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Hugging Face token for ZeroGPU video Spaces: https://huggingface.co/settings/tokens
HF_TOKEN=
# Upstash Redis (quota + rate limits when deployed): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Supabase (Postgres + pgvector + storage): https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional model id overrides (free models change) ---
# MODEL_GROQ_GPT_OSS_120B=openai/gpt-oss-120b
# MODEL_GEMINI_FLASH_LITE=gemini-3.5-flash-lite
# MODEL_GEMINI_FLASH=gemini-3.8-flash

# --- Per-user daily soft limits (IST day). Defaults shown. ---
# SOFT_LIMIT_CHAT=250
# SOFT_LIMIT_IMAGE=15
# SOFT_LIMIT_SEARCH=40
# SOFT_LIMIT_VOICE=60
# SOFT_LIMIT_UPLOAD=25

# Optional model id overrides when a free model is renamed, e.g.
# MODEL_ZAI_GLM_FLASH=glm-4.7-flash

# NOTE: OPENAI_API_KEY is deliberately never read by this app (it is deleted
# from process.env at startup). Do not add it here.
